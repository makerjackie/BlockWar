{
  "name": "blockwar",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n assets,worker \"pnpm dev:assets\" \"pnpm dev:worker\"",
    "dev:assets": "vite build --watch",
    "dev:worker": "wrangler dev",
    "build": "pnpm build:client && pnpm typecheck",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "check": "pnpm build:client && pnpm typecheck && pnpm test",
    "deploy:dry-run": "pnpm build:client && wrangler deploy --dry-run",
    "deploy": "pnpm build:client && wrangler deploy"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "hono": "^4.9.6",
    "i18next": "^25.6.0",
    "lodash": "^4.17.21",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.36",
    "@tailwindcss/vite": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.6.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "wrangler": "^4.43.0"
  }
}
